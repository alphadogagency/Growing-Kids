---
import Header from '../components/Header.astro';
import CallToAction from '../components/CallToAction.astro';
import CenterPicker from '../components/CenterPicker.astro';
import Footer from '../components/Footer.astro';
import centers from '../data/centers.json';
import '../styles/global.css';
import '../styles/homepage.css';
const differences=[
 {title:'Safe And Secure Facilities',image:'teacher-and-child',alt:'A Growing Kids teacher sits with a young child in a classroom.',text:'Monitored entrances, classroom cameras and security planning help you feel confident at drop-off.'},
 {title:'Inspiring Education And Curriculum',image:'painting',alt:'Children paint together at a Growing Kids classroom table.',text:'ELM (Early Learning Matters) and Conscious Discipline support learning and kindergarten readiness.'},
 {title:'Convenience And Dependability',image:'center-exterior',alt:'The entrance to a Growing Kids Learning Center.',text:'Extended hours and centers close to home help care fit your family’s day.'},
 {title:'Playgrounds And Learning Environment',image:'outdoor-play',alt:'Outdoor play equipment in a Growing Kids playground.',text:'Outdoor play and Main Street, our child-sized mini town, make room for imagination and discovery.'},
 {title:'Family Owned And Community Driven',image:'growing-kids-family',alt:'Members of the Growing Kids family pictured together.',text:'Family ownership and local accountability keep decisions close to the families we serve.'},
 {title:'Qualified Teachers',image:'storytime',alt:'A teacher reads a picture book with young children.',text:'Caring teachers help children build the academic, social and physical skills they will use in school.'}
];
const programs=[['Infants','A caring start for your little one.','/programs/infants/'],['Toddlers And Young Preschool','Room to explore, play and make friends.','/programs/toddlers/'],['Preschool','Learning that builds kindergarten readiness.','/programs/preschool/'],['School Age Care','Support before and after the school day.','/programs/school-age-care/'],['Camps','New experiences during school breaks.','/programs/camps/']];
const stories=[
 {id:'FOYOtXzyU0s',image:'family-video',title:'A Family And A Home',duration:'0:57'},
 {id:'H2VtnAuG1T4',image:'readiness-video',title:'Getting Ready For Kindergarten',duration:'2:11'},
 {id:'x3jyscqbA9E',image:'schedule-video',title:'Care That Fits Your Schedule',duration:'1:01'}
];
const cities=[...new Set(centers.map(c=>c.city))];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Explore family-owned preschool and child care at ten Growing Kids Learning Centers across Northern Indiana. Find your center and schedule a tour."/><title>Daycare &amp; Preschool In Northern Indiana | Growing Kids</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700;800&family=Nunito+Sans:wght@400;600&display=swap" rel="stylesheet"/></head>
<body class="homepage">
<div class="preview-bar">Homepage preview <span>·</span> <a href="#preview-notes">Review pending content</a></div>
<Header home />
<main id="main">
<section class="home-hero" aria-labelledby="home-heading">
<picture class="hero-photo"><source media="(max-width:700px)" srcset="/images/playground-900.webp"/><img src="/images/playground.webp" width="1600" height="491" alt="Children playing together on the slide at Growing Kids." fetchpriority="high" data-shoot="replace"/></picture>
<div class="hero-wrap wrap"><div class="hero-panel"><h1 id="home-heading">Watch Them Grow</h1><p>Family-owned daycare and preschool with ELM learning, thoughtful safety and ten Northern Indiana centers close to home.</p><div id="find-your-center"><CenterPicker id="hero-center"/></div></div></div>
</section>
<CallToAction home compact id="first-cta-heading"/>
<section class="trust-band" aria-label="Quality and care"><div class="wrap trust-items"><div><img src="/images/necpa.webp" width="140" height="94" alt="NECPA accreditation"/><p><strong>Nationally Accredited</strong><span>National Early Childhood Program Accreditation</span></p></div><div><img src="/images/paths-to-quality.webp" width="140" height="94" alt="Paths to QUALITY"/><p><strong>Paths To QUALITY Level 4</strong><span>Indiana’s highest quality rating</span></p></div><div><p><strong>Family Owned. Close To Home.</strong><span>Ten centers across Northern Indiana</span></p></div></div></section>
<section class="difference section-space wrap" id="difference"><div class="section-intro"><h2>The Growing Kids Difference</h2><p>Preschool is about more than a place to spend the day. It is a safe place to learn, a teacher who cares and space for your child’s imagination to grow.</p></div>
<div class="difference-grid">{differences.map(d=><article><img src={`/images/${d.image}.webp`} alt={d.alt} width="520" height="347" loading="lazy" data-shoot="replace"/><h3>{d.title}</h3><p>{d.text}</p></article>)}</div>
<div class="section-tail"><a class="button secondary" href="https://growingkids.com/why-choose-us/">See All Our Differences</a><p class="content-note">Preview note · Descriptions use the brief and current site. Exact outline wording is pending reconciliation.</p></div></section>
<section class="curriculum-section section-space" id="curriculum"><div class="wrap curriculum-layout"><div class="curriculum-photo"><img src="/images/early-writing.webp" alt="A preschool child practices writing at a classroom table." width="760" height="760" loading="lazy" data-shoot="replace"/></div><div class="curriculum-copy"><h2>Little Discoveries.<br/>Big Beginnings.</h2><p>Our preschool program uses ELM (Early Learning Matters) with Conscious Discipline to build kindergarten readiness.</p><p>Hands-on activities give children ways to explore, ask questions and learn together. In the classroom and on Main Street, play is part of learning.</p><a class="button primary" href="https://growingkids.com/programs/preschool/">Explore Preschool</a><a class="text-link" href="#programs">Find Your Child’s Program</a></div></div></section>
<section class="program-section section-space wrap" id="programs"><div class="section-intro"><h2>How Old Is Your Child?</h2><p>Explore preschool and child care programs for each stage of growing up.</p></div><div class="program-list">{programs.map(([name,description,path])=><a href={`https://growingkids.com${path}`}><h3>{name}</h3><p>{description}</p><span class="program-link">Explore Program <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></span></a>)}</div></section>
<section class="families-section section-space" id="families"><div class="wrap"><div class="section-intro"><h2>The Growing Kids Families</h2><p>Hear from parents about the people, learning and everyday care that matter to their families.</p></div><div class="stories">{stories.map((story,index)=><article><div class="video-frame"><button class="video-trigger" data-video={story.id} aria-label={`Play ${story.title} parent video`}><img src={`/images/${story.image}.webp`} alt={`Parent interview from Growing Kids’ ${story.title} video.`} width="640" height="360" loading="lazy"/><span class="video-play"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 11 7-11 7z"/></svg><span>Watch <span class="duration">{story.duration}</span></span></span></button></div><h3>{story.title}</h3><a class="video-fallback" href={`https://www.youtube.com/watch?v=${story.id}`} aria-label={`Watch ${story.title} on YouTube`}>Watch On YouTube</a><div class="quote-slot" data-content-status="pending"><p>Parent quote {index+1} pending</p><span>Approved quote, first name, center and parent badge photo to come from Bridget.</span></div></article>)}</div><a class="button secondary" href="https://growingkids.com/testimonials/">More Parent Stories</a></div></section>
<section class="tuition-section section-space" id="tuition-support"><div class="wrap tuition-layout"><div><h2>A Little Support<br/>Goes A Long Way.</h2><p>Ask your center about help with preschool and child care tuition. Families experiencing hardship are encouraged to talk with their director.</p><a class="button secondary" href="tel:5749707500">Talk About Tuition Support</a><p class="content-note">Preview note · The full tuition-support page is next. Current rates and eligibility come from your center.</p></div><ul class="support-list"><li>CCDF Vouchers</li><li>On My Way Pre-K</li><li>AutoPay Discount</li><li>Refer-a-Friend Credit</li><li>Employer Benefits</li></ul></div></section>
<section class="centers-section section-space wrap" id="centers"><div class="centers-layout"><div><h2>Ten Centers.<br/>One Growing Kids Family.</h2><p>From South Bend to Warsaw, find preschool and child care close to the places your family calls home.</p><img class="center-photo" src="/images/center-exterior.webp" alt="The Growing Kids Learning Center entrance beneath a blue sky." width="760" height="506" loading="lazy" data-shoot="replace"/></div><div class="cities-list">{cities.map(city=><div><h3>{city}</h3><ul>{centers.filter(c=>c.city===city).map(c=><li><a href={`https://growingkids.com${c.location_path}`}>{c.name.replace(`, ${city}`,'')}<svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a></li>)}</ul></div>)}</div></div></section>
<section class="anniversary-section" id="our-family"><div class="wrap anniversary-layout"><img src="/standard-logo.png" alt="Growing Kids Learning Centers" width="180" height="107" loading="lazy"/><div><h2>30 Years Of Northern Indiana Families</h2><p>Family owned. Locally rooted. Growing together.</p><p class="content-note">Preview note · Anniversary wording and founding year await Bridget’s confirmation.</p></div><div class="anniversary-slot"><strong>Anniversary Video</strong><p>Client video pending</p></div></div></section>
<section class="enrollment-section section-space wrap" id="pre-register"><div><h2>Reserve Your Child’s Spot</h2><p>Infant and toddler rooms are our fullest and often have a short wait. Preschool and school age usually have room. Either way, pre-register and we’ll confirm your start date.</p></div><div class="registration-pending" data-content-status="pending"><h3>Pre-Registration Setup Pending</h3><p>This preview’s pre-registration flow is awaiting confirmation. You can use the current inquiry form to ask about care.</p><a class="button secondary" href="https://app.tryplayground.com/form/MpmqWSuS7XbbNhll8U9o/HJnwK3ewsarKLlkjCzkX">Request Information</a></div></section>
<CallToAction home id="last-cta-heading"/>
<details class="preview-notes wrap" id="preview-notes"><summary>Homepage Preview Notes</summary><ul><li>This is the homepage review draft. Supporting pages still open the existing website.</li><li>Tour and inquiry actions open existing destinations. The shorter inquiry form, preferred contact channel, booking reminders and CRM receipts still need verification.</li><li>Pre-registration is pending: the checked Ireland Road listing still uses a paid waitlist and displays a conflicting address. Kyle and Bridget need to reconcile provider settings before this flow can open.</li><li>Three review quotes and parent badge photos, final NAP, founding year and anniversary video remain client inputs. Differentiator wording awaits the original outline. Placeholder notes stay visible for review.</li><li>No analytics or public deployment is included in this local preview.</li></ul></details>
</main><Footer preview/>
<script>
 document.querySelectorAll<HTMLFormElement>('[data-center-picker]').forEach(form=>form.addEventListener('submit',event=>{event.preventDefault();const select=form.querySelector('select');if(select?.value){const target=new URL(select.value);if(['growingkids.com','app.tryplayground.com'].includes(target.hostname))window.location.assign(target.href);}}));
 document.querySelectorAll<HTMLButtonElement>('[data-video]').forEach(button=>button.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src=`https://www.youtube-nocookie.com/embed/${button.dataset.video}?autoplay=1&rel=0`;frame.title=button.getAttribute('aria-label')||'Growing Kids parent video';frame.allow='autoplay; encrypted-media; picture-in-picture';frame.allowFullscreen=true;button.replaceWith(frame);}));
 const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');menu?.addEventListener('keydown',event=>{if(event.key==='Escape'){menu.open=false;menu.querySelector('summary')?.focus();}});menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.open=false;}));
 function openPreviewNotes(){if(location.hash==='#preview-notes'){const notes=document.querySelector<HTMLDetailsElement>('#preview-notes');if(notes)notes.open=true;}} window.addEventListener('hashchange',openPreviewNotes);openPreviewNotes();
</script>
</body></html>
