---
import SiteLayout from '../layouts/SiteLayout.astro';
import centers from '../data/centers.json';

---
<SiteLayout title="Reserve Your Child’s Spot | Growing Kids" description="Ask Growing Kids about openings and next steps for your child. Pre-registration configuration is pending; the current inquiry form is available." breadcrumbs={[{name:"Reserve Your Child’s Spot",path:"/pre-register/"}]}><section class="page-hero"><div class="wrap"><h1>Reserve Your Child’s Spot</h1><p class="intro">Tell us when your family will need preschool or child care. Your center can discuss openings, next steps and the start date that fits your child’s age and classroom.</p><div class="hero-actions"><a class="button primary" href="/request-information/">Request Information</a></div></div></section>
<section class="section butter"><div class="wrap split"><h2>A place for your next chapter.</h2><div><p>Infant and toddler rooms are our fullest and often have a short wait. Preschool and school age usually have room. Either way, pre-register and we’ll confirm your start date.</p><p class="review-note"><strong>Pre-registration setup pending</strong>The current enrollment destination needs correction before this preview can offer a verified registration path. Please use the inquiry form or call your center to discuss care. No place, payment or start date is confirmed by this page.</p><a class="button primary" href="/request-information/">Request Information</a></div></div></section><section class="section"><div class="wrap"><h2>Talk with your center.</h2><ul class="link-list">{centers.map(c=><li><a href={c.location_path}>{c.name}</a> · <a href={`tel:${c.provisional_phone.replace(/\D/g,'')}`}>{c.provisional_phone}</a></li>)}</ul><p><a href="/programs/">Explore programs</a> · <a href="/tuition-support/">Learn about tuition support</a></p></div></section>
</SiteLayout>