---
import SiteLayout from '../layouts/SiteLayout.astro';import legal from '../data/legal.json';const policy=legal.find(p=>p.slug==='privacy-policy')!;
---
<SiteLayout title={`${policy.title} | Growing Kids`} description={`Read the existing Growing Kids ${policy.title.toLowerCase()} and contact the team with questions.`} breadcrumbs={[{name:policy.title,path:'/privacy-policy/'}]}><section class="page-hero"><div class="wrap"><h1>{policy.title}</h1><p class="intro">This is the policy published on the current Growing Kids website, carried into this review build.</p></div></section><section class="section"><div class="wrap reading"><p class="review-note"><strong>Policy review before launch</strong>The existing text is preserved here. The client must confirm its accuracy for the new site and provider setup.</p><Fragment set:html={policy.html}/><p><a href="/request-information/">Request information</a> · <a href="/resource-policy-library/">Parent policies</a> · <a href="/locations/">Our centers</a></p></div></section></SiteLayout>