---
import SiteLayout from '../layouts/SiteLayout.astro';
import centers from '../data/centers.json';import AreaCenterPicker from '../components/AreaCenterPicker.astro';
const cities=[...new Set(centers.map(c=>c.city))];
---
<SiteLayout title="Find Your Growing Kids | Growing Kids" description="Find ten Growing Kids preschool and child care centers across Northern Indiana. Compare locations, see center details and schedule a tour." breadcrumbs={[{name:"Find Your Growing Kids",path:"/locations/"}]}><section class="page-hero"><div class="wrap"><h1>Find Your Growing Kids</h1><p class="intro">Explore ten family-owned preschool and child care centers across seven Northern Indiana communities. Choose a city, compare center details and find a school along your everyday route.</p><div class="hero-actions"><a class="button primary" href="#find-your-center">Find Your Center</a></div></div></section>
<section class="section cream" id="find-your-center"><div class="wrap"><h2>Close to the places you call home.</h2><AreaCenterPicker id="directory-area"/><p>Browse by city · {cities.map((city,i)=><>{i>0&&' · '}<a href={centers.find(c=>c.city===city)!.market_path}>{city}</a></>)}</p><iframe class="map-frame" title="Map of Growing Kids centers in Northern Indiana" src="https://maps.google.com/maps?q=Growing%20Kids%20Learning%20Centers%20Northern%20Indiana&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe><p><a href="https://www.google.com/maps/search/Growing+Kids+Learning+Centers+Northern+Indiana">Open the center map in Google Maps</a></p></div></section><section class="section"><div class="wrap">{cities.map(city=><section class="directory-city"><h2>{city}</h2><div class="center-directory">{centers.filter(c=>c.city===city).map(c=><article class="directory-entry"><h3><a href={c.location_path}>{c.name.split(',')[0]}</a></h3><p>{c.provisional_address}</p><p><a href={`tel:${c.provisional_phone.replace(/\D/g,'')}`}>{c.provisional_phone}</a></p><p>{c.provisional_hours}</p><div class="hero-actions"><a class="button primary" href={c.tour_path} data-center={c.name}>Schedule a Tour</a><a class="button secondary" href={c.location_path}>View Center</a></div></article>)}</div></section>)}<p class="review-note"><strong>Center details under review</strong>These are current-site addresses, phones and hours. Final citation details and infant-room schedules need confirmation before launch.</p></div></section>
</SiteLayout>