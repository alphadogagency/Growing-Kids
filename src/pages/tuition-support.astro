import SiteLayout from '../layouts/SiteLayout.astro';


---
<SiteLayout title="Care For Your Child. Support For Your Family. | Growing Kids" description="Learn how Growing Kids tuition is structured and explore support options. Ask your center about current rates, eligibility and discounts." breadcrumbs={[{name:"Care For Your Child. Support For Your Family.",path:"/tuition-support/"}]}><section class="page-hero"><div class="wrap"><h1>Care For Your Child. Support For Your Family.</h1><p class="intro">Growing Kids tuition depends on your child’s age, the days you need and your center. Ask your center for current rates and help understanding the support options available to your family.</p><div class="hero-actions"><a class="button primary" href="/book-a-tour/">Schedule a Tour</a></div></div></section>
<section class="section butter"><div class="wrap split"><h2>Start with the care you need.</h2><div><p>Tell your center your child’s age, preferred days and when you hope to begin. The team can explain current tuition, openings and which assistance programs may fit.</p><a class="button secondary" href="/locations/">Find Your Center</a></div></div></section><section class="section"><div class="wrap"><h2>Ways to make tuition more manageable.</h2><div class="day-rhythm"><article data-care-reveal><h3>CCDF vouchers</h3><p>Growing Kids accepts Indiana Child Care and Development Fund vouchers. Ask your center how to use your authorization and which costs your family may be responsible for.</p></article><article data-care-reveal><h3>On My Way Pre-K</h3><p>Growing Kids participates in On My Way Pre-K. This Indiana program supports preschool for eligible families. Your center can help you understand the next steps and current eligibility requirements.</p></article><article data-care-reveal><h3>AutoPay discount</h3><p>Families who use weekly AutoPay can receive a tuition discount. Ask your center for the current discount and payment setup details.</p></article><article data-care-reveal><h3>Refer-a-Friend credit</h3><p>The Refer-a-Friend program offers tuition credit when a referred family joins Growing Kids. Check the current credit, timing and program terms with your center.</p></article></div></div></section><section class="section sage"><div class="wrap split"><div><h2>Your employer may help, too.</h2><p>Growing Kids has child care benefit arrangements with area employers. Ask your HR team whether your workplace participates and ask your center how the benefit works.</p></div><div><h2>A conversation can help.</h2><p>Families experiencing hardship are encouraged to talk with their director.</p><a class="text-link" href="/request-information/">Request information about tuition</a></div></div></section><section class="section"><div class="wrap"><p>Explore <a href="/programs/">programs by age</a> or read <a href="/faqs/">answers to common tuition questions</a>.</p></div></section>
</SiteLayout>