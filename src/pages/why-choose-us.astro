---
import SiteLayout from '../layouts/SiteLayout.astro';
import CareIcon from '../components/CareIcon.astro';import CallToAction from '../components/CallToAction.astro';
const differences=[{"title": "Safe and Secure Facilities", "icon": "safety", "text": "Monitored entrances, biometric check-in and classroom cameras support daily safety. Growing Kids developed security protocols with a child care security firm run by former Secret Service agents. Observation windows let parents see classroom life.", "path": "/locations/", "link": "Visit a center and see the safety features"}, {"title": "Inspiring Education and Curriculum", "icon": "learning", "text": "ELM (Early Learning Matters) and Conscious Discipline support kindergarten readiness. Hands-on activities, stories and conversations help children build skills they can use at school and at home.", "path": "/curriculum/", "link": "Explore our curriculum"}, {"title": "Convenience and Dependability", "icon": "time", "text": "Ten centers across Northern Indiana help families find care along their daily route. Center hours vary, and school age care supports families before and after the school day and during breaks.", "path": "/locations/", "link": "Compare centers and hours"}, {"title": "Playgrounds and Learning Environment", "icon": "play", "text": "Main Street is a child-size town where pretend play becomes a way to learn. Children take on roles, solve problems and play together. Outdoors, playgrounds give children room to move when weather allows.", "path": "/programs/", "link": "Explore programs for your child"}, {"title": "Family Owned and Community Driven", "icon": "family", "text": "Beth and Mike Garatoni built Growing Kids around the needs of children and parents. Local ownership keeps accountability close to the families and communities our schools serve.", "path": "/team/", "link": "Meet the Growing Kids family"}, {"title": "Qualified Teachers", "icon": "teaching", "text": "Teachers bring early childhood education and classroom experience to their work. Training continues after orientation, including pediatric CPR and First Aid. A behavioral specialist supports the team in helping children learn and grow.", "path": "/team/", "link": "Learn about our teachers"}];
---
<SiteLayout title="The Growing Kids Difference | Growing Kids" description="Explore the Growing Kids Difference: safety, purposeful learning, dependable care, play spaces, family ownership and caring teachers." breadcrumbs={[{name:"The Growing Kids Difference",path:"/why-choose-us/"}]}><section class="page-hero"><div class="wrap"><h1>The Growing Kids Difference</h1><p class="intro">Growing Kids brings preschool learning and dependable child care together. Safe spaces, purposeful play, family ownership and teachers who know your child shape the day from arrival to pick-up.</p><div class="hero-actions"><a class="button primary" href="/book-a-tour/">Schedule a Tour</a></div></div></section>
{differences.map((d,i)=><section class:list={['section',i%2===0?'cream':'']}><div class="wrap"><div class="difference-row" data-care-reveal><CareIcon kind={d.icon}/><div><h2>{d.title}</h2><p>{d.text}</p><a class="text-link" href={d.path}>{d.link}</a></div></div>{i===3&&<img class="difference-photo" src="/images/centers/ireland-road-2.webp" alt="Colorful child-size storefronts in Growing Kids Main Street" width="1200" height="600" loading="lazy" data-shoot="replace"/>}<CallToAction compact id={`difference-cta-${i}`}/></div></section>)}<section class="section"><div class="wrap"><p class="review-note"><strong>Proof still to add</strong>Verified parent pull quotes, center-specific photography and the original outline’s exact descriptions remain part of content review.</p></div></section>
</SiteLayout>