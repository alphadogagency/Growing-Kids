---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LeadPanel from '../../components/LeadPanel.astro';
import centers from '../../data/location-content.json';
import programs from '../../data/programs.json';
import reviews from '../../data/reviews.json';
export function getStaticPaths(){return centers.map(center=>({params:{slug:center.slug},props:{center}}));}
const {center:c}=Astro.props;
const title=`Daycare & Preschool in ${c.city}, IN | Growing Kids on ${c.street}`;
const address=c.provisional_address;const schema=[{'@type':'ChildCare','@id':`https://growingkids.com${c.location_path}`,name:`Growing Kids Learning Center - ${c.street}`,url:`https://growingkids.com${c.location_path}`,telephone:c.provisional_phone,address:{'@type':'PostalAddress',streetAddress:address.split(c.city)[0].replace(/,\s*$/,''),addressLocality:c.city,addressRegion:'IN',postalCode:address.match(/\d{5}$/)?.[0],addressCountry:'US'},openingHours:c.provisional_hours.replace(/(\d+):(\d+) am - (\d+):(\d+) pm \(Mon-Fri\)/,(_,h,m,e,n)=>`Mo-Fr ${h.padStart(2,'0')}:${m}-${Number(e)+12}:${n}`),parentOrganization:{'@id':'https://growingkids.com/#organization'}}];
---
<SiteLayout title={title} description={`Explore preschool and child care at Growing Kids on ${c.street} in ${c.city}. See programs, center details and schedule a tour.`} breadcrumbs={[{name:'Locations',path:'/locations/'},{name:c.street,path:c.location_path}]} schema={schema} tourPath={c.tour_path} center={c.name}>
<section class="page-hero location-hero"><div class="wrap"><div class="location-intro"><div><h1>Growing Kids on {c.street}, {c.city}</h1><p class="intro">Preschool and child care for children from six weeks through age 12, with familiar teachers, hands-on learning and room to play.</p><a class="text-link" href={c.market_path}>Explore daycare in {c.city}</a></div><div class="location-facts"><p><strong>{c.provisional_address.split(c.city)[0].replace(/,\s*$/,'')}<br/>{c.city}{c.provisional_address.split(c.city)[1]}</strong></p><p><a href={`tel:${c.provisional_phone.replace(/\D/g,'')}`}>Call {c.street} · {c.provisional_phone}</a></p><p>{c.provisional_hours}</p><a class="button primary" href={c.tour_path}>Schedule a Tour</a></div></div><img class="hero-panorama" src={c.hero} alt={c.heroAlt} width="1400" height="600" fetchpriority="high" data-shoot="replace"/></div></section>
<section class="section"><div class="wrap split"><div data-care-reveal><h2>People you’ll get to know.</h2><p>Meet the director and classroom teachers when you visit. Bring your child, ask questions and see how the day feels here.</p><div class="review-note"><strong>Director profile coming</strong>Name, title, photo and a personal introduction for this center are awaiting confirmation.</div><a class="text-link" href="/team/">Get to know Growing Kids</a></div><div data-care-reveal><h2>{c.positionHeading}</h2><p>{c.position}</p><a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(c.provisional_address)}`}>Get directions to this center</a></div></div></section>
<section class="section cream"><div class="wrap split"><div data-care-reveal><h2>Room to grow, at every age.</h2><p>From the first days of infant care to school breaks with friends, explore the programs at {c.street}. Ask our team about current openings and classroom schedules.</p><a class="text-link" href="/tuition-support/">See tuition and support options</a></div><ul class="program-list">{programs.map(p=><li><a href={`/programs/${p.slug}/`}><strong>{p.name}</strong><span>{p.age}</span></a></li>)}</ul></div></section>
<section class="section"><div class="wrap split"><div><h2>What parents say about {c.street}</h2>{reviews.filter(r=>r.center===c.name).map(r=><blockquote class="quote"><p>“{r.quote}”</p><cite>{r.name} · {r.center}</cite><a href={r.source}>Read the published story</a></blockquote>)}<p class="review-note"><strong>Parent stories under review</strong>Additional center-specific quotes and available badge photos will be added after attribution and permissions review.</p><a class="text-link" href="/testimonials/">Watch families share their experience</a></div><LeadPanel center={c.name}/></div></section>
<section class="section sage"><div class="wrap"><div class="split" data-care-reveal><h2>{c.featureHeading}</h2><p>{c.feature}</p></div><div class="photo-pair">{c.photos.map((src,i)=><img src={src} alt={c.photoAlts[i]} width="800" height="550" loading="lazy" data-shoot="replace"/>)}</div><p class="review-note"><strong>Center details under review</strong>Address, phone and hours reflect the current center page. Final citation details, school transportation and infant-room hours need confirmation before launch.</p></div></section>
</SiteLayout>
