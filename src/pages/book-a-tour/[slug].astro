---
import SiteLayout from '../../layouts/SiteLayout.astro';import centers from '../../data/centers.json';
export function getStaticPaths(){return centers.map(center=>({params:{slug:center.tour_path.split('/')[2]},props:{center}}));}
const {center:c}=Astro.props;
---
<SiteLayout title={`Tour ${c.name} | Growing Kids`} description={`Schedule a 30-minute visit to Growing Kids at ${c.name}. Children are welcome. See the classrooms and meet the director.`} breadcrumbs={[{name:'Schedule a Tour',path:'/book-a-tour/'},{name:c.name,path:c.tour_path}]} tourPath={c.tour_path} center={c.name}>
<section class="page-hero"><div class="wrap"><h1>Visit Growing Kids on {c.name}</h1><p class="intro">Choose an available time in our secure scheduler for a 30-minute tour. Bring your child, see the classrooms and Main Street and meet the director.</p><p>{c.provisional_address} · <a href={`tel:${c.provisional_phone.replace(/\D/g,'')}`}>{c.provisional_phone}</a></p><a class="text-link" href={c.location_path}>Explore this center</a></div></section><section class="section cream"><div class="wrap"><h2>Find a time for your family.</h2><p>The scheduler shows available dates, times and the center’s time zone. Your booking and confirmation are handled by Playground.</p><a class="button secondary" href={c.tour_embed_url} data-event="cta_tour_click" data-center={c.name}>Open Scheduler In A Full Page</a><div data-provider-embed={c.tour_embed_url} data-title={`Schedule a tour at ${c.name}`}><p>The scheduler appears here on secure HTTPS previews. Use the full-page link above to choose a time.</p></div><p>If the scheduler does not load, use the link above or call the center. <a href="/book-a-tour/">Choose a different center</a>.</p></div></section><section class="section"><div class="wrap split"><div><h2>What to expect on your tour.</h2><p>Plan for about 30 minutes. Children are welcome. You’ll see the classrooms and Main Street, meet the director and have time to ask about your child’s day.</p></div><div><h2>A few things to ask.</h2><p>Talk about your child’s <a href="/programs/">program</a>, your schedule and <a href="/tuition-support/">tuition options</a>. Let the director know about care needs you would like to discuss.</p></div></div></section></SiteLayout>
