---
import SiteLayout from '../layouts/SiteLayout.astro';import faqs from '../data/faqs.json';
const groups=['Enrollment and Openings','Tuition and Discounts','Tours','Daily Life','Safety','Health and Special Needs','Policies'];const schema=[{'@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}];
---
<SiteLayout title="Preschool & Child Care Questions | Growing Kids" description="Answers about Growing Kids enrollment, tuition, tours, daily routines, safety and family policies. Search questions or browse by topic." breadcrumbs={[{name:'FAQ',path:'/faqs/'}]} schema={schema}><section class="page-hero"><div class="wrap"><h1>Questions From Families Like Yours</h1><p class="intro">Find answers about Growing Kids preschool and child care, from choosing a center to everyday classroom routines. For a question about your child, talk with your center’s director.</p><div class="filter-control" hidden><label for="faq-search">Search questions and answers</label><input id="faq-search" type="search" placeholder="Try tuition, tours or meals" aria-describedby="faq-status"/></div><p id="faq-status" role="status">Browse {faqs.length} answers below.</p><p>{groups.map((g,i)=><>{i>0&&' · '}<a href={`#faq-${i}`}>{g}</a></>)}</p></div></section><section class="section cream"><div class="wrap reading">{groups.map((g,i)=><section class="faq-group" id={`faq-${i}`}><h2>{g}</h2>{faqs.filter(f=>f.group===g).map(f=><details data-faq><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>)}<p class="review-note"><strong>FAQ content review</strong>These answers combine the current published FAQ and November brief. The original outline’s full wording and center-specific operational details remain to be reconciled.</p></div></section><section class="section"><div class="wrap"><h2>Still have a question?</h2><p><a href="/request-information/">Request information</a>, explore <a href="/locations/">your center</a> or read the <a href="/resource-policy-library/">parent policies</a>.</p></div></section></SiteLayout>
