---
import SiteLayout from '../../layouts/SiteLayout.astro';import LeadPanel from '../../components/LeadPanel.astro';import programs from '../../data/programs.json';import centers from '../../data/centers.json';import reviews from '../../data/reviews.json';
export function getStaticPaths(){return programs.map(program=>({params:{slug:program.slug},props:{program}}));}
const {program:p}=Astro.props;
---
<SiteLayout title={`${p.name} in Northern Indiana | Growing Kids`} description={`${p.name} for ${p.age.toLowerCase()} at Growing Kids. Explore learning, daily routines and centers in Northern Indiana.`} breadcrumbs={[{name:'Programs',path:'/programs/'},{name:p.name,path:`/programs/${p.slug}/`}]}>
<section class="page-hero program-hero"><div class="wrap split"><div><h1>{p.headline}</h1><p class="age-label">{p.name} · {p.age}</p><p class="intro">{p.intro}</p><div class="hero-actions"><a class="button primary" href="/book-a-tour/">Schedule a Tour</a><a class="button secondary" href="#program-centers">Find Your Center</a></div></div><img src={`/images/${p.image}`} alt={p.alt} width="700" height="600" fetchpriority="high" data-shoot="replace"/></div></section>
<section class="section"><div class="wrap split"><div data-care-reveal><h2>{p.slug==='preschool'?'More than knowing the alphabet.':'Learning in everyday moments.'}</h2><p>{p.slug==='preschool'?'Kindergarten readiness includes confidence with other children, curiosity about new ideas and the ability to join a classroom routine. ELM (Early Learning Matters) and Conscious Discipline bring those skills together through play and purposeful activities.':'Children learn through the people, routines and experiences around them. Teachers help each child explore at their own pace.'}</p><a class="text-link" href="/curriculum/">Explore our approach to learning</a></div><ul class="link-list">{p.learn.map(s=><li><p>{s}</p></li>)}</ul></div></section>
<section class="section cream"><div class="wrap"><h2>A day with room for discovery.</h2><p>These are examples of the rhythms and activities you can ask about on a tour. Your classroom’s timing follows the children’s ages and needs.</p><div class="day-rhythm">{p.day.map(([h,t])=><article data-care-reveal><h3>{h}</h3><p>{t}</p></article>)}</div></div></section>
<section class="section"><div class="wrap split"><div><h2>Before the first day.</h2><p>{p.bring}</p><a class="text-link" href="/resource-policy-library/">Read parent policies and resources</a><p class="review-note"><strong>Classroom details under review</strong>Confirm the exact supply list, daily schedule and available days with your center.</p></div><LeadPanel program={p.name.toLowerCase()}/></div></section>
<section class="section sage" id="program-centers"><div class="wrap split"><div><h2>A Growing Kids near you.</h2><p>All ten centers list our infant through school age programs. Choose a school to ask about this program and current availability.</p><a class="text-link" href="/tuition-support/">Understand tuition and cost relief</a></div><ul class="link-list">{centers.map(c=><li><a href={c.location_path}>{c.name}</a></li>)}</ul></div></section>
<section class="section"><div class="wrap"><h2>From families who’ve been there.</h2><p>Hear parents talk about classroom life and getting ready for school.</p>{p.quotes.map(r=><blockquote class="quote"><p>“{r.quote}”</p><cite>{r.name} · {r.center||'Center not specified in the published story'}</cite><a href={r.source}>Read the published story</a></blockquote>)}<a class="text-link" href="/testimonials/">Watch parent stories</a><p class="review-note"><strong>Published quote review</strong>These are exact excerpts from existing parent stories. Badge photos and reuse permissions need final confirmation.</p></div></section>
</SiteLayout>
