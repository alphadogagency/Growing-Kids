---
import SiteLayout from '../layouts/SiteLayout.astro';
import centers from '../data/centers.json';import reviews from '../data/reviews.json';import archive from '../data/review-archive.json';
const videos=[{id:'FOYOtXzyU0s',image:'family-video',title:'A Family And A Home'},{id:'H2VtnAuG1T4',image:'readiness-video',title:'Getting Ready For Kindergarten'},{id:'x3jyscqbA9E',image:'schedule-video',title:'Care That Fits Your Schedule'}];
---
<SiteLayout title="From Growing Kids Families | Growing Kids" description="Read published Growing Kids parent stories, filter quotes by center and watch family videos about preschool and child care." breadcrumbs={[{name:"From Growing Kids Families",path:"/testimonials/"}]}><section class="page-hero"><div class="wrap"><h1>From Growing Kids Families</h1><p class="intro">Hear parents describe their experience with Growing Kids preschool and child care. Explore the family videos and verified published comments as we prepare the full collection of center stories.</p><div class="hero-actions"><a class="button primary" href="/book-a-tour/">Schedule a Tour</a></div></div></section>
<section class="section cream"><div class="wrap"><h2>Find stories from your center.</h2><div class="filter-control" hidden><label for="review-center">Center</label><select id="review-center"><option value="">All centers</option>{centers.map(c=><option value={c.name}>{c.name}</option>)}</select></div><p id="review-status" role="status">{reviews.length?`${reviews.length} published parent comments`:'Verified center-specific quotes and badge photos are being prepared.'}</p>{reviews.map(r=><blockquote class="quote" data-review-center={r.center}><p>“{r.quote}”</p><cite>{r.name} · {r.center||'Center not specified in the original story'}</cite><a class="text-link" href={r.source}>Read the published story</a></blockquote>)}<p class="review-note"><strong>Parent-story review</strong>Center attribution, badge photos and reuse permissions need final confirmation. No names, quotes or center assignments have been invented.</p></div></section><section class="section sage"><div class="wrap"><h2>In their own words.</h2><div class="video-list">{videos.map(v=><article><div class="video-frame"><button class="video-trigger" data-video={v.id} aria-label={`Play ${v.title} parent video`}><img src={`/images/${v.image}.webp`} alt={`Parent interview from ${v.title}`} width="640" height="360" loading="lazy"/><span class="video-play">Watch parent video</span></button></div><h3>{v.title}</h3><a href={`https://www.youtube.com/watch?v=${v.id}`}>Watch on YouTube</a></article>)}</div></div></section><section class="section"><div class="wrap"><p>See the <a href="/why-choose-us/">Growing Kids Difference</a>, explore <a href="/programs/">programs</a> or <a href="/locations/">find your center</a>.</p></div></section>
<section class="section"><div class="wrap"><details><summary>Browse the published story archive</summary><ul class="link-list">{archive.map(r=><li><a href={`/testimonial/${r.slug}/`}>{r.title}</a></li>)}</ul></details></div></section></SiteLayout>